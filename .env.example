# SeminarConnect Environment Configuration

# Next.js Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Required for Remote PostgreSQL, Auth & Private Document Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Payment Gateway (Indian INR Payments)
# When omitted, the platform automatically runs in deterministic test verification mode
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Geocoding Provider (Optional OpenStreetMap / Location API Key)
GEOCODING_API_KEY=
